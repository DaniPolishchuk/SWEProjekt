@startuml Klassendiagramm

' ============================================================
' Analyse-Klassendiagramm: Verwaltungssoftware Bauunternehmen
' DHBW Karlsruhe, TINF24B1, 2025/2026
' ============================================================

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam circledCharacterRadius 0
skinparam circledCharacterFontSize 0
skinparam classFontStyle bold
skinparam classFontSize 11
skinparam classHeaderBackgroundColor transparent
skinparam ArrowColor #555555
skinparam ArrowThickness 1.3
skinparam shadowing false
skinparam roundCorner 6
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam nodesep 80
skinparam ranksep 100
skinparam minClassWidth 130

' ============================================================
' EXTERNE SYSTEME
' ============================================================

package "Externe Systeme" #EEDDFF {
    class Finanzbuchhaltung #EEDDFF {}
    class Altsystem #EEDDFF {}
    class Drucker #EEDDFF {}
}

' ============================================================
' PERSONEN-GRUPPE (Blau)
' ============================================================

class Person #DDEEFF {
    vorname
    nachname
    telefonnummer
    email
}

class Adresse #DDEEFF {
    strasse
    hausnummer
    plz
    ort
    land
}

class Mitarbeiter #DDEEFF {
    mitarbeiternummer
    geburtsdatum
    position
    beschaeftigungsort
    vertragsbeginn
    vertragsende
}

class Unterauftragnehmer #DDEEFF {
    unterauftragnehmerID
    firmenname
    fachbereich
}

class Rolle #DDEEFF {
    rollennummer
    name
}

class Gruppe #DDEEFF {
    gruppennummer
    gruppenname
    gruppentyp
    beschreibung
}

class Anwesenheitszeit #DDEEFF {
    anwesenheitsID
    datum
    startzeit
    endzeit
    typ
    bemerkung
}

' ============================================================
' AUFTRAGS-GRUPPE (Orange)
' ============================================================

class Projekt #FFE8CC {
    projektnummer
    projektname
    starttermin
    endtermin
    beschreibung
    status
}

class Arbeitsauftrag #FFE8CC {
    auftragsnummer
    auftragsbezeichnung
    starttermin
    endtermin
    status
    bemerkung
}

class Unterauftrag #FFE8CC {
    unterauftragsnummer
    bezeichnung
    starttermin
    endtermin
    status
    kosten
    bemerkung
}

class Termin #FFE8CC {
    terminID
    datum
    startzeit
    endzeit
    typ
}

class Rechnung #FFE8CC {
    rechnungsnummer
    betrag
    faelligkeitsdatum
    status
}

class Dokument #FFE8CC {
    dokumentID
    titel
    dateipfad
    dateiname
    dateigroesse
    format
    hochladedatum
}

' ============================================================
' GERAETE-GRUPPE (Gruen)
' ============================================================

class "Geraete-Typ" as GeraeteTyp #CCEECC {
    geraeteTypID
    bezeichnung
    typ
    kategorie
}

class Geraet #CCEECC {
    geraeteNummer
    seriennummer
    status
    anschaffungsdatum
}

class Ausruestung #CCEECC {
    ausruestungsnummer
    bezeichnung
    typ
    kompatibel
    gewicht
    status
}

class Lager #CCEECC {
    lagernummer
    lagerbezeichnung
    typ
    grundstueck
    kapazitaet
}

class Buchung #CCEECC {
    buchungsnummer
    startdatum
    enddatum
    buchungsdatum
    status
}

' ============================================================
' BILDER (Rot)
' ============================================================

class Bild #FFDDDD {
    bildID
    titel
    dateipfad
    dateiname
    elementtyp
    hochladedatum
    dateigroesse
    format
}

' ============================================================
' BEZIEHUNGEN
' ============================================================

' Vererbung
Mitarbeiter        -down-|> Person
Unterauftragnehmer -down-|> Person

' Adresse
Person         -down-> "1"    Adresse
Lager          -down-> "1"    Adresse
Projekt        -right-> "1"   Adresse
Arbeitsauftrag -right-> "1"   Adresse

' Mitarbeiter
Mitarbeiter -right-> "1"    Rolle
Mitarbeiter *-right- "0..*" Anwesenheitszeit
Mitarbeiter "0..*" -left- "0..*" Gruppe
Gruppe      -right-> "0..1" Mitarbeiter

' Projekt & Auftrag
Projekt        -right-> "1"    Mitarbeiter
Arbeitsauftrag -down->  "1"    Projekt
Arbeitsauftrag -right-> "1..*" Mitarbeiter
Arbeitsauftrag *-left-  "0..*" Unterauftrag
Arbeitsauftrag -left->  "0..*" Dokument
Unterauftrag   -down->  "0..1" Unterauftragnehmer
Termin         -left->  "0..*" Arbeitsauftrag
Termin         -down->  "0..*" Projekt

' Rechnung
Rechnung          -down-> "1" Arbeitsauftrag
Finanzbuchhaltung ..>     Rechnung : <<read>>

' Geraete
Geraet -down->  "1"    GeraeteTyp
Geraet -left->  "1"    Lager
Geraet -left->  "0..*" Termin
Lager  *-down-  "0..*" Ausruestung

' Koordinator: Buchung
Buchung -down->  "1..*" Geraet
Buchung -left->  "1"    Arbeitsauftrag
Buchung -right-> "1"    Mitarbeiter

' Bilder (LF80)
Mitarbeiter *-down-> "0..*" Bild
Projekt     "0..*" -down-> "0..*" Bild
Geraet      "0..*" -down-> "0..*" Bild
Bild        -up->   "1"    Mitarbeiter

@enduml
