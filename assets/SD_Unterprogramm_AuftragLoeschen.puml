@startuml SD_Unterprogramm_AuftragLoeschen
title Unterprogramm: Auftrag archivieren

skinparam dpi 150
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam sequenceMessageAlign center
skinparam sequenceArrowThickness 1
skinparam roundCorner 8
skinparam BoxPadding 14

<style>
participant {
  padding 12
}
</style>
skinparam SequenceGroupBorderThickness 1

skinparam ActorBackgroundColor #FFE9CC
skinparam ActorBorderColor #C97A1B
skinparam ParticipantBackgroundColor #DCE9F9
skinparam ParticipantBorderColor #2E5C9A
skinparam DatabaseBackgroundColor #E6E6E6
skinparam DatabaseBorderColor #555555
skinparam sequence {
    GroupBackgroundColor #F7F7F7
    GroupBorderColor     #888888
}

' ====================================================
'  Unterprogramm für den Archivierungsvorgang eines
'  Arbeitsauftrags. Logisches Löschen gemäß LL 20:
'    1. Aktive Buchungen auf STORNIERT setzen
'    2. Arbeitsauftrag auf ARCHIVIERT setzen und
'       Statusänderung persistieren
'  Kein physisches Entfernen; die per Komposition
'  zugeordneten Unteraufträge und Termine bleiben
'  gemeinsam mit dem Auftrag erhalten und sind
'  während der zehnjährigen Aufbewahrungsfrist
'  weiterhin lesbar.
' ====================================================

actor       ":Bau-/Projektleiter" as Leiter
participant ":UI Bauverwaltung"   as UI         #DCE9F9
database    ":Datenbasis"          as DB         #E6E6E6
participant ":Arbeitsauftrag"      as Auftrag    #FFE3B0

note over Leiter, Auftrag
  Eingabe: Referenz auf den zu archivierenden Arbeitsauftrag.
  Voraussetzung: Der Auftrag wurde im Hauptdiagramm
  durch den Bau-/Projektleiter ausgewählt.
end note

' --- Schritt 1: Aktive Buchungen prüfen und stornieren ---
UI -> DB: 1: Aktive Buchungen zum Auftrag abfragen
activate DB
DB --> UI: 1.1: Buchungsliste
deactivate DB

alt Aktive Buchungen vorhanden
    UI --> Leiter: 2: Hinweis -- aktive Buchungen vorhanden
    Leiter -> UI: 2.1: Buchungen stornieren bestätigen

    loop für jede aktive Buchung
        group #E5D4F7 ref Status setzen :Buchung = "STORNIERT"
        end
    end
else Keine aktiven Buchungen
    UI --> Leiter: 2.2: Archivierungsbestätigung anfordern
    Leiter -> UI: 2.3: Archivieren bestätigen
end

' --- Schritt 2: Arbeitsauftrag archivieren ---
note over UI, Auftrag
  Logisches Löschen gemäß LL 20:
  Der Auftrag wird nicht physisch entfernt.
  Unteraufträge und Termine bleiben per
  Komposition mit dem Auftrag verbunden
  und sind während der zehnjährigen
  Aufbewahrungsfrist weiterhin lesbar.
end note

group #E5D4F7 ref Status setzen :Arbeitsauftrag = "ARCHIVIERT"
end

UI -> DB: 3: Statusänderung persistieren
activate DB
DB --> UI: 3.1: Bestätigung
deactivate DB

UI --> Leiter: 4: Bestätigung -- Auftrag archiviert

@enduml
