@startuml Aktivitaetsdiagramm_Buchung
title Aktivitätsdiagramm: Gerät anlegen und buchen

' ====================================================
'  Skinparams -- konsistent zum SD-Kapitel
' ====================================================
skinparam dpi 150
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam ArrowThickness 1
skinparam ActivityBorderThickness 1

skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #555555
skinparam ActivityStartColor #333333
skinparam ActivityEndColor #333333

skinparam SwimlaneBorderColor #888888
skinparam SwimlaneBorderThickness 1

' Farbkonvention (konsistent zum SD-Kapitel):
'   #FFE3B0 = Benutzer-Aktionen (Akteur-Aktionen)
'   #CFE3F3 = prüfende Operationen (Verfügbarkeit, Duplikat laden)
'   #C8E6C9 = System-Aktionen (Instanzerzeugung, Persistierung)
'   #A5D6A7 = Buchungs-Aktionen (Koordinator-Muster)
'   #FFD7D7 = Fehler-/Warnpfade

|Verwaltungsmitarbeiter|
|Bau-/Projektleiter|
|System (UI Bauverwaltung)|
|Datenbasis|

|Verwaltungsmitarbeiter|

start

' ====================================================
'  TEIL A: Geräte-Typ anlegen
' ====================================================

:Gerätemanagement öffnen; <<#FFE3B0>>

:Neuen Geräte-Typ anlegen wählen; <<#FFE3B0>>

:Pflichtfelder eingeben\n(Bezeichnung, Typ, Kategorie); <<#FFE3B0>>
|System (UI Bauverwaltung)|
:Eingaben validieren; <<#C8E6C9>>

while (Pflichtfelder unvollständig?) is (ja)
  |Verwaltungsmitarbeiter|
  :Pflichtfelder korrigieren; <<#FFE3B0>>
  |System (UI Bauverwaltung)|
  :Eingaben validieren; <<#C8E6C9>>
endwhile (nein)

|Datenbasis|
:Bestehende Geräte-Typen laden\n(Duplikatsprüfung LF 100); <<#CFE3F3>>

|System (UI Bauverwaltung)|
if (Geräte-Typ existiert bereits?) then (ja)
  :Warnung ausgeben\n(Duplikat -- LF 100); <<#FFD7D7>>
  |Verwaltungsmitarbeiter|
  :Eingabe korrigieren\noder Vorgang abbrechen; <<#FFD7D7>>
  stop
else (nein)
  |System (UI Bauverwaltung)|
endif

:Geräte-Typ-Instanz erzeugen\nund Attribute setzen; <<#C8E6C9>>

|Datenbasis|
:Geräte-Typ persistieren; <<#C8E6C9>>
:Bestätigung; <<#C8E6C9>>

|Verwaltungsmitarbeiter|
:Bestätigung anzeigen\n(Geräte-Typ angelegt); <<#C8E6C9>>

' ====================================================
'  TEIL B: Konkretes Gerät (Exemplar) anlegen
' ====================================================

:Neues Gerät anlegen wählen; <<#FFE3B0>>

|System (UI Bauverwaltung)|
:Lagerliste laden; <<#CFE3F3>>

|Verwaltungsmitarbeiter|
if (Passendes Lager vorhanden?) then (ja)
  :Lager aus Liste auswählen; <<#FFE3B0>>
else (nein)
  :Neue Lagerbezeichnung\nund Adresse eingeben; <<#FFE3B0>>
  |Datenbasis|
  :Bestehende Lager laden\n(Duplikatsprüfung LF 100); <<#CFE3F3>>
  |System (UI Bauverwaltung)|
  if (Lager bereits vorhanden?) then (ja)
    :Warnung ausgeben\n(Duplikat -- LF 100); <<#FFD7D7>>
    |Verwaltungsmitarbeiter|
    :Eingabe korrigieren\noder Vorgang abbrechen; <<#FFD7D7>>
    stop
  else (nein)
    |System (UI Bauverwaltung)|
  endif
  :Adresse-Instanz erzeugen; <<#C8E6C9>>
  :Lager-Instanz erzeugen\nund Adresse zuordnen; <<#C8E6C9>>
  |Datenbasis|
  :Lager persistieren; <<#C8E6C9>>
  |Verwaltungsmitarbeiter|
endif

:Pflichtfelder eingeben\n(Gerätenummer, Seriennummer,\nAnschaffungsdatum, Wartungstermin); <<#FFE3B0>>
|System (UI Bauverwaltung)|
:Eingaben validieren; <<#C8E6C9>>

while (Pflichtfelder unvollständig?) is (ja)
  |Verwaltungsmitarbeiter|
  :Pflichtfelder korrigieren; <<#FFE3B0>>
  |System (UI Bauverwaltung)|
  :Eingaben validieren; <<#C8E6C9>>
endwhile (nein)

|Datenbasis|
:Bestehende Geräte laden\n(Duplikatsprüfung LF 100); <<#CFE3F3>>

|System (UI Bauverwaltung)|
if (Seriennummer bereits vorhanden?) then (ja)
  :Warnung ausgeben\n(Duplikat -- LF 100); <<#FFD7D7>>
  |Verwaltungsmitarbeiter|
  :Eingabe korrigieren\noder Vorgang abbrechen; <<#FFD7D7>>
  stop
else (nein)
  |System (UI Bauverwaltung)|
endif

:Gerät-Instanz erzeugen; <<#C8E6C9>>
:Geräte-Typ zuordnen; <<#C8E6C9>>
:Lager zuordnen; <<#C8E6C9>>
:Status setzen ("VERFUEGBAR"); <<#C8E6C9>>

|Verwaltungsmitarbeiter|
if (Zubehör wird ergänzt?) then (ja)
  :Ausrüstungsdaten eingeben\n(Bezeichnung, Kompatibilität, Gewicht); <<#FFE3B0>>
  |System (UI Bauverwaltung)|
  :Ausrüstungs-Instanz erzeugen\nund Gerät zuordnen (Baugruppe-Muster); <<#C8E6C9>>
  |Verwaltungsmitarbeiter|
  while (Weiteres Zubehör ergänzen?) is (ja)
    :Nächste Ausrüstung eingeben; <<#FFE3B0>>
    |System (UI Bauverwaltung)|
    :Ausrüstungs-Instanz erzeugen\nund Gerät zuordnen; <<#C8E6C9>>
    |Verwaltungsmitarbeiter|
  endwhile (nein)
else (nein)
endif

|Datenbasis|
:Gerät (inkl. Ausrüstung) persistieren; <<#C8E6C9>>
:Bestätigung; <<#C8E6C9>>

|Verwaltungsmitarbeiter|
:Bestätigung anzeigen\n(Gerät angelegt); <<#C8E6C9>>

' ====================================================
'  TEIL C: Gerät für Arbeitsauftrag buchen
' ====================================================

|Bau-/Projektleiter|

:Buchungsverwaltung öffnen; <<#FFE3B0>>

:Gerät und Buchungszeitraum\nauswählen; <<#FFE3B0>>

|Datenbasis|
:Buchungen für das Gerät laden; <<#CFE3F3>>

|System (UI Bauverwaltung)|
:Verfügbarkeit prüfen\n(Zeitraumkollision?); <<#CFE3F3>>

|Bau-/Projektleiter|
if (Gerät im Zeitraum verfügbar?) then (nein)
  :Hinweis: Gerät nicht verfügbar; <<#FFD7D7>>
  if (Alternative Geräte suchen?) then (ja)
    |Datenbasis|
    :Geräte desselben Typs\nladen (verfügbar im Zeitraum); <<#CFE3F3>>
    |Bau-/Projektleiter|
    :Alternatives Gerät auswählen; <<#FFE3B0>>
  else (nein)
    stop
  endif
else (ja)
endif

|Datenbasis|
:Auftragsliste laden; <<#CFE3F3>>

|Bau-/Projektleiter|
:Arbeitsauftrag aus Liste auswählen; <<#FFE3B0>>

|System (UI Bauverwaltung)|
:Buchungs-Instanz erzeugen\n(Gerät, Arbeitsauftrag, Zeitraum,\naktiver Benutzer als Parameter); <<#A5D6A7>>
:Buchungs-Status setzen ("AKTIV"); <<#A5D6A7>>

|Datenbasis|
:Buchung persistieren; <<#A5D6A7>>
:Bestätigung; <<#A5D6A7>>

|Bau-/Projektleiter|
:Bestätigung anzeigen\n(Buchung angelegt); <<#A5D6A7>>

stop

@enduml
